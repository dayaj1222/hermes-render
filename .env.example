# Hermes on Render — Environment Variables
# Copy this to .env and fill in your values, or set these directly on Render dashboard
#
# Your local setup uses:
#   base_url: http://localhost:8000/v1
#   model: deepseek-reasoner
#   provider: custom
#
# For Render, localhost won't work — you need a publicly reachable endpoint.
# Options below.

# === Telegram Bot (required for gateway) ===
# Create a bot at https://t.me/BotFather and paste the token here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# === LLM Proxy (required) ===
# This must be a URL Render can reach — not localhost!

# Option 1: Expose your local proxy publicly (ngrok/Cloudflare Tunnel/tailscale funnel)
LLM_BASE_URL=https://your-tunnel-url.ngrok-free.app/v1
LLM_MODEL=deepseek-reasoner

# Option 2: Use DeepSeek's API directly (cheap, no proxy needed)
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-reasoner
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# Option 3: OpenRouter (if you want fallback models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-r1
# OPENROUTER_API_KEY=sk-or-v1-your-key
