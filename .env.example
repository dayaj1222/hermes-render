# Hermes on Render — Environment Variables
# Set these on Render dashboard (or copy to .env for local testing)

# === Telegram Bot (required) ===
# Create at https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# === DeepSeek Proxy Credentials (required) ===
# The proxy uses DeepSeek web login (not API key) via aiodeepseek
DEEPSEEK_EMAIL=your-deepseek-email@example.com
DEEPSEEK_PASSWORD=your-deepseek-password
DEEPSEEK_TOKEN=your-deepseek-token-if-you-have-one

# === Proxy Settings (optional) ===
# MODEL_TYPE=DEFAULT
# REQUEST_DELAY=0
