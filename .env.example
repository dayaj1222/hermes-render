# Hermes on Render — Environment Variables
# Copy this to .env and fill in your values, or set these directly on Render dashboard

# === Telegram Bot (required for gateway) ===
# Create a bot at https://t.me/BotFather and paste the token here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# === LLM Provider (pick one) ===

# Option 1: OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-4o

# Option 2: DeepSeek (cheaper)
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-chat

# Option 3: OpenRouter (access to many models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-your-openrouter-key
# LLM_MODEL=anthropic/claude-sonnet-4

# Option 4: Any OpenAI-compatible endpoint
# LLM_BASE_URL=https://your-endpoint.com/v1
# LLM_API_KEY=your-api-key
# LLM_MODEL=your-model-name
